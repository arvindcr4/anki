#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VERSION="${1:-$(date '+%Y.%m.%d.%H%M')}"
OUT_DIR="${2:-$REPO_ROOT/out/anki-tikz-release}"
MANIFEST_URL="${ANKI_TIKZ_UPDATE_MANIFEST_URL:-https://arvindcr4.github.io/anki/anki-tikz-updates/anki-tikz-appcast.xml}"
ARTIFACT_URL="${ANKI_TIKZ_ARTIFACT_URL:-https://github.com/arvindcr4/anki/releases/download/anki-tikz-$VERSION/Anki%20TikZ-$VERSION.zip}"
SPARKLE_PRIVATE_KEY_FILE="${ANKI_TIKZ_SPARKLE_PRIVATE_KEY_FILE:-$HOME/Library/Application Support/AnkiTikZ/sparkle_private_ed_key}"
SPARKLE_PUBLIC_ED_KEY="${ANKI_TIKZ_SPARKLE_PUBLIC_ED_KEY:-}"
SPARKLE_ROOT="${ANKI_TIKZ_SPARKLE_ROOT:-}"
CODESIGN_IDENTITY="${ANKI_TIKZ_CODESIGN_IDENTITY:-}"
NOTARIZE="${ANKI_TIKZ_NOTARIZE:-0}"

BUILD_ROOT="$OUT_DIR/build"
APP_PATH="$BUILD_ROOT/Anki TikZ.app"
ZIP_PATH="$OUT_DIR/Anki TikZ-$VERSION.zip"
MANIFEST_PATH="$OUT_DIR/anki-tikz-appcast.xml"

rm -rf "$BUILD_ROOT"
mkdir -p "$BUILD_ROOT" "$OUT_DIR"

if [[ -z "$SPARKLE_PUBLIC_ED_KEY" ]]; then
  SPARKLE_PUBLIC_ED_KEY="$("$SCRIPT_DIR/sparkle-keygen" --private-key-file "$SPARKLE_PRIVATE_KEY_FILE" --print-public-key)"
fi

if [[ -z "$SPARKLE_ROOT" ]]; then
  SPARKLE_ROOT="$("$SCRIPT_DIR/fetch-sparkle")"
fi

install_args=(
  "$APP_PATH"
  --version "$VERSION"
  --manifest-url "$MANIFEST_URL"
  --sparkle-public-ed-key "$SPARKLE_PUBLIC_ED_KEY"
  --sparkle-root "$SPARKLE_ROOT"
  --embed-source
  --no-launch-agent
)

ANKI_TIKZ_VERSION="$VERSION" "$SCRIPT_DIR/install-anki-tikz-app" "${install_args[@]}"

if [[ -n "$CODESIGN_IDENTITY" ]]; then
  SPARKLE_FRAMEWORK="$APP_PATH/Contents/Library/Sparkle/sparkle.app/Contents/Frameworks/Sparkle.framework"
  if [[ -d "$SPARKLE_FRAMEWORK" ]]; then
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$SPARKLE_FRAMEWORK/Versions/B/XPCServices/Installer.xpc"
    /usr/bin/codesign --force --timestamp --options runtime --preserve-metadata=entitlements --sign "$CODESIGN_IDENTITY" "$SPARKLE_FRAMEWORK/Versions/B/XPCServices/Downloader.xpc"
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$SPARKLE_FRAMEWORK/Versions/B/Autoupdate"
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$SPARKLE_FRAMEWORK/Versions/B/Updater.app"
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$SPARKLE_FRAMEWORK"
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$APP_PATH/Contents/Library/Sparkle/sparkle.app"
  fi
  find "$APP_PATH/Contents" -type f \( -perm -0100 -o -perm -0010 -o -perm -0001 \) -print0 | while IFS= read -r -d '' executable; do
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$executable" || true
  done
  /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$APP_PATH"
  /usr/bin/codesign --verify --strict "$APP_PATH"
fi

rm -f "$ZIP_PATH"
(cd "$BUILD_ROOT" && /usr/bin/ditto -ck --sequesterRsrc --keepParent "Anki TikZ.app" "$ZIP_PATH")

if [[ "$NOTARIZE" == "1" ]]; then
  /usr/bin/xcrun notarytool submit "$ZIP_PATH" --keychain-profile "${ANKI_TIKZ_NOTARY_PROFILE:-default}" --wait
  /usr/bin/xcrun stapler staple "$APP_PATH"
  rm -f "$ZIP_PATH"
  (cd "$BUILD_ROOT" && /usr/bin/ditto -ck --sequesterRsrc --keepParent "Anki TikZ.app" "$ZIP_PATH")
fi

SHA256="$(/usr/bin/shasum -a 256 "$ZIP_PATH" | awk '{print $1}')"
SIZE="$(stat -f '%z' "$ZIP_PATH")"
SIGNATURE="$("$SPARKLE_ROOT/bin/sign_update" --ed-key-file "$SPARKLE_PRIVATE_KEY_FILE" -p "$ZIP_PATH")"

/usr/bin/python3 - "$MANIFEST_PATH" "$VERSION" "$ARTIFACT_URL" "$SIZE" "$SIGNATURE" <<'PY'
from pathlib import Path
import datetime as dt
import email.utils
import sys
import xml.sax.saxutils as saxutils

manifest_path = Path(sys.argv[1])
version = sys.argv[2]
artifact_url = sys.argv[3]
size = int(sys.argv[4])
signature = sys.argv[5]
pub_date = email.utils.format_datetime(dt.datetime.now(dt.timezone.utc))
manifest = f'''<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Anki TikZ Updates</title>
    <item>
      <title>Version {saxutils.escape(version)}</title>
      <sparkle:version>{saxutils.escape(version)}</sparkle:version>
      <sparkle:shortVersionString>{saxutils.escape(version)}</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>12.0</sparkle:minimumSystemVersion>
      <pubDate>{pub_date}</pubDate>
      <enclosure
        url="{saxutils.escape(artifact_url)}"
        sparkle:edSignature="{saxutils.escape(signature)}"
        length="{size}"
        type="application/octet-stream" />
    </item>
  </channel>
</rss>
'''
manifest_path.write_text(manifest, encoding="utf-8")
PY

echo "Release app: $APP_PATH"
echo "Archive: $ZIP_PATH"
echo "Manifest: $MANIFEST_PATH"
echo "SHA-256: $SHA256"
echo "Sparkle public EdDSA key: $SPARKLE_PUBLIC_ED_KEY"
