#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VERSION="${1:-$(date '+%Y.%m.%d.%H%M')}"
OUT_DIR="${2:-$REPO_ROOT/out/anki-tikz-release}"
MANIFEST_URL="${ANKI_TIKZ_UPDATE_MANIFEST_URL:-https://github.com/arvindcr4/anki/releases/latest/download/anki-tikz-appcast.json}"
ARTIFACT_URL="${ANKI_TIKZ_ARTIFACT_URL:-https://github.com/arvindcr4/anki/releases/download/anki-tikz-$VERSION/Anki%20TikZ-$VERSION.zip}"
PUBLIC_KEY="${ANKI_TIKZ_UPDATE_PUBLIC_KEY:-}"
SIGNING_KEY="${ANKI_TIKZ_SIGNING_KEY:-}"
CODESIGN_IDENTITY="${ANKI_TIKZ_CODESIGN_IDENTITY:-}"
NOTARIZE="${ANKI_TIKZ_NOTARIZE:-0}"

BUILD_ROOT="$OUT_DIR/build"
APP_PATH="$BUILD_ROOT/Anki TikZ.app"
ZIP_PATH="$OUT_DIR/Anki TikZ-$VERSION.zip"
MANIFEST_PATH="$OUT_DIR/anki-tikz-appcast.json"

rm -rf "$BUILD_ROOT"
mkdir -p "$BUILD_ROOT" "$OUT_DIR"

install_args=(
  "$APP_PATH"
  --version "$VERSION"
  --manifest-url "$MANIFEST_URL"
  --embed-source
  --no-launch-agent
)

if [[ -n "$PUBLIC_KEY" ]]; then
  install_args=("${install_args[@]}" --public-key "$PUBLIC_KEY" --require-signature)
fi

ANKI_TIKZ_VERSION="$VERSION" "$SCRIPT_DIR/install-anki-tikz-app" "${install_args[@]}"

if [[ -n "$CODESIGN_IDENTITY" ]]; then
  find "$APP_PATH/Contents" -type f \( -perm -0100 -o -perm -0010 -o -perm -0001 \) -print0 | while IFS= read -r -d '' executable; do
    /usr/bin/codesign --force --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$executable" || true
  done
  /usr/bin/codesign --force --deep --timestamp --options runtime --sign "$CODESIGN_IDENTITY" "$APP_PATH"
  /usr/bin/codesign --verify --deep --strict "$APP_PATH"
fi

rm -f "$ZIP_PATH"
(cd "$BUILD_ROOT" && /usr/bin/ditto -ck --sequesterRsrc --keepParent "Anki TikZ.app" "$ZIP_PATH")

if [[ "$NOTARIZE" == "1" ]]; then
  /usr/bin/xcrun notarytool submit "$ZIP_PATH" --keychain-profile "${ANKI_TIKZ_NOTARY_PROFILE:-default}" --wait
  /usr/bin/xcrun stapler staple "$APP_PATH"
  rm -f "$ZIP_PATH"
  (cd "$BUILD_ROOT" && /usr/bin/ditto -ck --sequesterRsrc --keepParent "Anki TikZ.app" "$ZIP_PATH")
fi

SHA256="$(/sbin/shasum -a 256 "$ZIP_PATH" | awk '{print $1}')"
SIZE="$(stat -f '%z' "$ZIP_PATH")"
SIGNATURE=""

if [[ -n "$SIGNING_KEY" ]]; then
  /usr/bin/openssl dgst -sha256 -sign "$SIGNING_KEY" -out "$ZIP_PATH.sig" "$ZIP_PATH"
  SIGNATURE="$(base64 < "$ZIP_PATH.sig" | tr -d '\n')"
fi

/usr/bin/python3 - "$MANIFEST_PATH" "$VERSION" "$ARTIFACT_URL" "$SHA256" "$SIZE" "$SIGNATURE" <<'PY'
from pathlib import Path
import datetime as dt
import json
import sys

manifest_path = Path(sys.argv[1])
version = sys.argv[2]
artifact_url = sys.argv[3]
sha256 = sys.argv[4]
size = int(sys.argv[5])
signature = sys.argv[6]

artifact = {
    "url": artifact_url,
    "sha256": sha256,
    "size": size,
}
if signature:
    artifact["signature"] = signature

manifest = {
    "updates": [
        {
            "version": version,
            "build": version,
            "channel": "stable",
            "platform": "macos-universal",
            "minimum_system_version": "12.0",
            "published_at": dt.datetime.now(dt.timezone.utc).isoformat(),
            "artifact": artifact,
        }
    ]
}

manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
PY

echo "Release app: $APP_PATH"
echo "Archive: $ZIP_PATH"
echo "Manifest: $MANIFEST_PATH"
echo "SHA-256: $SHA256"
