#!/bin/zsh
set -euo pipefail

APP_PATH="/Applications/Anki TikZ.app"
INSTALL_AGENT=1
EMBED_SOURCE=0
MANIFEST_URL="${ANKI_TIKZ_UPDATE_MANIFEST_URL:-https://arvindcr4.github.io/anki/anki-tikz-updates/anki-tikz-appcast.xml}"
UPDATE_CHANNEL="${ANKI_TIKZ_UPDATE_CHANNEL:-stable}"
VERSION="${ANKI_TIKZ_VERSION:-25.09.2-tikz}"
SPARKLE_PUBLIC_ED_KEY="${ANKI_TIKZ_SPARKLE_PUBLIC_ED_KEY:-}"
SPARKLE_PRIVATE_KEY_FILE="${ANKI_TIKZ_SPARKLE_PRIVATE_KEY_FILE:-$HOME/Library/Application Support/AnkiTikZ/sparkle_private_ed_key}"
SPARKLE_ROOT="${ANKI_TIKZ_SPARKLE_ROOT:-}"

usage() {
  cat <<USAGE
Usage: tools/install-anki-tikz-app [APP_PATH] [options]

Options:
  --app-path PATH        Install path. Defaults to /Applications/Anki TikZ.app.
  --manifest-url URL    Sparkle appcast XML URL used by the updater.
  --channel NAME        Update channel. Defaults to stable.
  --version VERSION     Bundle version written to Info.plist.
  --sparkle-public-ed-key KEY
                         Base64 EdDSA public key for Sparkle update verification.
  --sparkle-private-key-file PATH
                         Base64 EdDSA private seed used to derive the public key.
  --sparkle-root PATH    Existing Sparkle distribution root. Defaults to out/sparkle.
  --embed-source        Copy this checkout into the app bundle for release builds.
  --no-launch-agent     Do not register the per-user background updater now.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --app-path)
      APP_PATH="$2"
      shift 2
      ;;
    --manifest-url)
      MANIFEST_URL="$2"
      shift 2
      ;;
    --channel)
      UPDATE_CHANNEL="$2"
      shift 2
      ;;
    --version)
      VERSION="$2"
      shift 2
      ;;
    --sparkle-public-ed-key)
      SPARKLE_PUBLIC_ED_KEY="$2"
      shift 2
      ;;
    --sparkle-private-key-file)
      SPARKLE_PRIVATE_KEY_FILE="$2"
      shift 2
      ;;
    --sparkle-root)
      SPARKLE_ROOT="$2"
      shift 2
      ;;
    --embed-source)
      EMBED_SOURCE=1
      shift
      ;;
    --no-launch-agent)
      INSTALL_AGENT=0
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      APP_PATH="$1"
      shift
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
APP_NAME="$(basename "$APP_PATH" .app)"
LAUNCHER="$APP_PATH/Contents/MacOS/AnkiTikZ"
RESOURCES="$APP_PATH/Contents/Resources"
SPARKLE_DEST="$APP_PATH/Contents/Library/Sparkle"
SPARKLE_CLI="$SPARKLE_DEST/sparkle.app/Contents/MacOS/sparkle"
SPARKLE_RUNNER="$SPARKLE_DEST/run-sparkle-update"

mkdir -p "$APP_PATH/Contents/MacOS" "$RESOURCES" "$SPARKLE_DEST"

if [[ -z "$SPARKLE_PUBLIC_ED_KEY" ]]; then
  SPARKLE_PUBLIC_ED_KEY="$("$SCRIPT_DIR/sparkle-keygen" --private-key-file "$SPARKLE_PRIVATE_KEY_FILE" --print-public-key)"
fi

if [[ -z "$SPARKLE_ROOT" ]]; then
  SPARKLE_ROOT="$("$SCRIPT_DIR/fetch-sparkle")"
fi

if [[ ! -x "$SPARKLE_ROOT/sparkle.app/Contents/MacOS/sparkle" ]]; then
  echo "Sparkle CLI not found in $SPARKLE_ROOT" >&2
  exit 1
fi

rm -rf "$SPARKLE_DEST/sparkle.app"
/usr/bin/ditto "$SPARKLE_ROOT/sparkle.app" "$SPARKLE_DEST/sparkle.app"

cat > "$SPARKLE_RUNNER" <<'RUNNER'
#!/bin/zsh
set +e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_BUNDLE="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SPARKLE_CLI="$SCRIPT_DIR/sparkle.app/Contents/MacOS/sparkle"
MANIFEST_URL=__ANKI_TIKZ_SPARKLE_FEED_URL__
UPDATE_CHANNEL=__ANKI_TIKZ_SPARKLE_CHANNEL__

channel_args=()
if [[ -n "$UPDATE_CHANNEL" && "$UPDATE_CHANNEL" != "stable" ]]; then
  channel_args=(--channels "$UPDATE_CHANNEL")
fi

extra_args=()
manual_check=0
for arg in "$@"; do
  extra_args+=("$arg")
  case "$arg" in
    --check-immediately|--interactive|--allow-major-upgrades)
      manual_check=1
      ;;
  esac
done

"$SPARKLE_CLI" "$APP_BUNDLE" \
  --application "$APP_BUNDLE" \
  --feed-url "$MANIFEST_URL" \
  --grant-automatic-checks \
  --defer-install \
  --user-agent-name "Anki TikZ" \
  "${extra_args[@]}" \
  "${channel_args[@]}"

sparkle_status=$?
case "$sparkle_status" in
  0)
    exit 0
    ;;
  1|2|6)
    if [[ "$manual_check" == "1" ]]; then
      exit "$sparkle_status"
    fi
    exit 0
    ;;
  *)
    exit "$sparkle_status"
    ;;
esac
RUNNER

/usr/bin/python3 - "$SPARKLE_RUNNER" "$MANIFEST_URL" "$UPDATE_CHANNEL" <<'PY'
from pathlib import Path
import shlex
import sys

runner = Path(sys.argv[1])
text = runner.read_text()
text = text.replace("__ANKI_TIKZ_SPARKLE_FEED_URL__", shlex.quote(sys.argv[2]))
text = text.replace("__ANKI_TIKZ_SPARKLE_CHANNEL__", shlex.quote(sys.argv[3]))
runner.write_text(text)
PY
chmod +x "$SPARKLE_RUNNER"

/usr/bin/python3 - "$APP_PATH/Contents/Info.plist" "$APP_NAME" "$VERSION" "$MANIFEST_URL" "$SPARKLE_PUBLIC_ED_KEY" <<'PY'
from pathlib import Path
import plistlib
import sys

path = Path(sys.argv[1])
app_name = sys.argv[2]
version = sys.argv[3]
manifest_url = sys.argv[4]
public_ed_key = sys.argv[5]
info = {
    "CFBundleDevelopmentRegion": "en",
    "CFBundleDisplayName": app_name,
    "CFBundleExecutable": "AnkiTikZ",
    "CFBundleIdentifier": "net.ankiweb.dtop.tikz.local",
    "CFBundleInfoDictionaryVersion": "6.0",
    "CFBundleName": app_name,
    "CFBundlePackageType": "APPL",
    "CFBundleShortVersionString": version,
    "CFBundleVersion": version,
    "LSApplicationCategoryType": "public.app-category.education",
    "LSMinimumSystemVersion": "12.0",
    "NSHighResolutionCapable": True,
    "SUAllowsAutomaticUpdates": True,
    "SUAutomaticallyUpdate": True,
    "SUEnableAutomaticChecks": True,
    "SUEnableInstallerLauncherService": True,
    "SUFeedURL": manifest_url,
    "SUPublicEDKey": public_ed_key,
    "SUScheduledCheckInterval": 14400,
    "SUVerifyUpdateBeforeExtraction": True,
}
path.write_bytes(plistlib.dumps(info))
PY

cat > "$LAUNCHER" <<'LAUNCHER'
#!/bin/zsh
set -e

APP_SOURCE_DIR=__ANKI_TIKZ_SOURCE_DIR__
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_BUNDLE="$(cd "$SCRIPT_DIR/../.." && pwd)"
EMBEDDED_SOURCE="$APP_BUNDLE/Contents/Resources/source"
SUPPORT_DIR="$HOME/Library/Application Support/AnkiTikZ"
LOG_DIR="$HOME/Library/Logs"
LOG_FILE="$LOG_DIR/AnkiTikZSparkle.log"
RUN_PID_FILE="$SUPPORT_DIR/run.pid"

mkdir -p "$SUPPORT_DIR" "$LOG_DIR"

log() {
  print -r -- "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

notify() {
  /usr/bin/osascript -e "display notification \"$1\" with title \"Anki TikZ\"" >/dev/null 2>&1 || true
}

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export ANKI_TIKZ_APP_BUNDLE="$APP_BUNDLE"
export ANKI_TIKZ_SPARKLE_FEED_URL=__ANKI_TIKZ_SPARKLE_FEED_URL__
export ANKI_TIKZ_SPARKLE_CLI="$APP_BUNDLE/Contents/Library/Sparkle/sparkle.app/Contents/MacOS/sparkle"
export ANKI_TIKZ_SPARKLE_RUNNER="$APP_BUNDLE/Contents/Library/Sparkle/run-sparkle-update"

if [[ -f "$HOME/.zshrc" ]]; then
  source "$HOME/.zshrc"
fi

if [[ -d "$EMBEDDED_SOURCE" && -f "$EMBEDDED_SOURCE/tools/run.py" ]]; then
  APP_SOURCE_DIR="$EMBEDDED_SOURCE"
fi

if [[ ! -f "$APP_SOURCE_DIR/tools/run.py" ]]; then
  log "launch failed: missing tools/run.py in $APP_SOURCE_DIR"
  notify "Could not find the Anki TikZ runtime."
  exit 1
fi

print -r -- "$$" > "$RUN_PID_FILE"

cd "$APP_SOURCE_DIR"

export PYTHONWARNINGS="${PYTHONWARNINGS:-default}"
export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-out/pycache}"
export PYENV="${PYENV:-out/pyenv}"
export QTWEBENGINE_REMOTE_DEBUGGING="${QTWEBENGINE_REMOTE_DEBUGGING:-8080}"
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---remote-allow-origins=http://localhost:$QTWEBENGINE_REMOTE_DEBUGGING}"
export ANKI_API_PORT="${ANKI_API_PORT:-40000}"
export ANKI_API_HOST="${ANKI_API_HOST:-127.0.0.1}"

exec "$PYENV/bin/python" tools/run.py "$@"
LAUNCHER

/usr/bin/python3 - "$LAUNCHER" "$REPO_ROOT" "$MANIFEST_URL" <<'PY'
from pathlib import Path
import shlex
import sys

launcher = Path(sys.argv[1])
source_dir = shlex.quote(sys.argv[2])
feed_url = shlex.quote(sys.argv[3])
text = launcher.read_text()
text = text.replace("__ANKI_TIKZ_SOURCE_DIR__", source_dir)
text = text.replace("__ANKI_TIKZ_SPARKLE_FEED_URL__", feed_url)
launcher.write_text(text)
PY

chmod +x "$LAUNCHER"

if [[ "$EMBED_SOURCE" == "1" ]]; then
  SOURCE_DEST="$RESOURCES/source"
  mkdir -p "$SOURCE_DEST"
  rsync -a --delete \
    --exclude='.git/' \
    --exclude='.mypy_cache/' \
    --exclude='.ruff_cache/' \
    --exclude='anki_tikz_backups/' \
    --exclude='extra/' \
    --exclude='out/anki-tikz-release/' \
    --exclude='out/sparkle/' \
    --exclude='out/pycache/' \
    --exclude='out/tmp/' \
    --exclude='out/bazel/' \
    "$REPO_ROOT/" "$SOURCE_DEST/"
fi

if [[ "$INSTALL_AGENT" == "1" ]]; then
  OLD_LABEL="net.ankiweb.tikz.updater"
  OLD_PLIST="$HOME/Library/LaunchAgents/$OLD_LABEL.plist"
  NEW_LABEL="net.ankiweb.tikz.sparkle-updater"
  NEW_PLIST="$HOME/Library/LaunchAgents/$NEW_LABEL.plist"
  UID_VALUE="$(id -u)"
  DOMAIN="gui/$UID_VALUE"
  LOG_FILE="$HOME/Library/Logs/AnkiTikZSparkle.log"

  /bin/launchctl bootout "$DOMAIN" "$OLD_PLIST" >/dev/null 2>&1 || true
  rm -f "$OLD_PLIST"

  mkdir -p "$HOME/Library/LaunchAgents" "$(dirname "$LOG_FILE")"
  /usr/bin/python3 - "$NEW_PLIST" "$NEW_LABEL" "$SPARKLE_RUNNER" "$LOG_FILE" <<'PY'
from pathlib import Path
import plistlib
import sys

plist_path = Path(sys.argv[1])
label = sys.argv[2]
sparkle_runner = sys.argv[3]
log_file = sys.argv[4]
plist = {
    "Label": label,
    "ProgramArguments": [
        sparkle_runner,
    ],
    "RunAtLoad": True,
    "StartInterval": 14400,
    "ProcessType": "Background",
    "StandardOutPath": log_file,
    "StandardErrorPath": log_file,
}
plist_path.write_bytes(plistlib.dumps(plist))
PY

  /bin/launchctl bootout "$DOMAIN" "$NEW_PLIST" >/dev/null 2>&1 || true
  /bin/launchctl bootstrap "$DOMAIN" "$NEW_PLIST" >/dev/null 2>&1 || true
  /bin/launchctl kickstart -k "$DOMAIN/$NEW_LABEL" >/dev/null 2>&1 || true
fi

/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP_PATH" >/dev/null 2>&1 || true

echo "Installed $APP_NAME at $APP_PATH"
echo "Sparkle updater: $MANIFEST_URL"
